# Wazo Platform Version. Can be a branch name, a tag name, or "latest".
WAZO_VERSION=latest

# Shared secret for services to authenticate with wazo-auth
# This should be a long, random string.
WAZO_AUTH_TOKEN=a-very-secret-and-random-token-for-auth

# RabbitMQ connection
RABBITMQ_HOST=rabbitmq

# Other settings
INIT_TIMEOUT=180
TZ=America/Montreal
XIVO_UUID=00000000-0000-4000-8000-0000000AA450

POSTGRES_DB=wazo
POSTGRES_USER=asterisk
POSTGRES_PASSWORD=secret