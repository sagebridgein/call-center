[moto_auth]
type=auth
username=moto
password=moto2
auth_type=userpass

[moto_aor]
type=aor
max_contacts=5
remove_existing=yes
qualify_frequency=60
qualify_timeout=3
default_expiration=1800

[moto_identify]
type=identify
endpoint=moto
match=0.0.0.0/0

[moto]
type=endpoint
transport=transport-udp-local
context=ctx-mycompany-internal-2a6e174d-f496-4bb0-91ab-d5621735e1c5
disallow=all
allow=ulaw,alaw
auth=moto_auth
aors=moto_aor
callerid="moto" <963981>
direct_media=no
force_rport=yes
ice_support=no
rewrite_contact=yes
rtp_symmetric=yes
dtmf_mode=rfc4733
trust_id_inbound=yes
trust_id_outbound=yes
device_state_busy_at=1
send_rpid=yes
